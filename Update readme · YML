name: 🤖 Auto-Update Projects

on:
  schedule:
    # Runs every 6 hours
    - cron: "0 */6 * * *"
  workflow_dispatch:   # Allow manual trigger from GitHub UI
  push:
    branches: [main, master]
    paths-ignore:
      - "README.md"    # Avoid infinite loops

jobs:
  update-readme:
    name: Fetch Repos & Rebuild Projects Section
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
      - name: ⬇️  Checkout profile repo
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: 🐍  Set up Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: 📦  Install dependencies
        run: pip install requests

      - name: 🔄  Run project fetcher
        env:
          GITHUB_TOKEN:    ${{ secrets.GITHUB_TOKEN }}
          GITHUB_USERNAME: SHADRACK152
        run: python scripts/fetch_projects.py

      - name: 💾  Commit & push changes
        run: |
          git config --local user.email "github-actions[bot]@users.noreply.github.com"
          git config --local user.name  "github-actions[bot]"
          git diff --quiet && echo "No changes to commit." || (
            git add README.md &&
            git commit -m "🤖 chore: auto-update projects [skip ci]" &&
            git push
          )
